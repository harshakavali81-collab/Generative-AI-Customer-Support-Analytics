# Local development defaults — do not commit actual secrets
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
SUPPORT_DOCS_DIR=data/source_docs
SUPPORT_DB_PATH=instance/analytics.sqlite3
EVENT_RETENTION_DAYS=30
# Development has no chat/analytics tokens unless defined
ADMIN_TOKEN=
CHAT_API_TOKEN=
# In-process demo-only limiter; set 0 to disable (development only)
RATE_LIMIT_PER_MINUTE=0
# Remote LLM is OFF by default and requires a private API key and consent
ENABLE_REMOTE_LLM=false
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
